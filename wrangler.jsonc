{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "den-seje-app-frontend",
  "compatibility_date": "2026-08-04",
  "main": "worker/index.js",

  // STATIC ASSETS + ONE SMALL SCRIPT (157P). The asset layer answers every request that matches
  // a file in "directory" BEFORE the script runs, exactly as before; worker/index.js only sees
  // what no asset matched. It owns read-aloud and nothing else:
  //   GET|HEAD /tts/v<N>/<sha256>.mp3|.json -> cached Azure clip + word timings from R2
  //   POST     /api/tts                     -> get-or-create one clip (Supabase JWT, rate limit)
  // and hands everything else back to the asset layer (-> 404 page). The app still talks to
  // Supabase directly from the browser. Secrets (never in this file, never in Git):
  //   AZURE_SPEECH_KEY, AZURE_SPEECH_REGION, TTS_ADMIN_TOKEN  -> `wrangler secret put <NAME>`
  // Local development reads them from .dev.vars (gitignored). See docs/157o-read-aloud.md.
  //
  // "directory" is the generated output of tools/cloudflare-build-static.mjs — NEVER the repo
  // root. The root holds .env files, the docs/ decision register, tests/, tools/, supabase/ and
  // tracked node_modules; the build script copies only an explicit allowlist and then re-validates
  // the result, so none of that can be published. worker/ is bundled by Wrangler as code and is
  // never copied into the assets.
  // ROUTING CONTRACT: ASYMMETRIC BY DESIGN.
  //
  //   public clean route      -> internal 200 rewrite to its HTML file (_redirects). The address
  //                              bar keeps the clean path; no 3xx is emitted.
  //   public legacy .html URL -> permanent 301 to the clean route. /produktet.html is no longer a
  //                              page of its own; one preferred URL per public page.
  //   internal app .html URL  -> UNCHANGED, a direct 200. /index.html, /login.html, /hub.html and
  //                              the rest keep their addresses.
  //   anything else           -> a real 404.
  //
  // `auto-trailing-slash` - the Cloudflare default - would strip the extension and 307 EVERY .html
  // address, the app included:
  //     /login.html -> 307 -> /login        /teacher.html -> 307 -> /teacher
  // This is a traditional multipage app: its runtime links, the role redirects in js/login.js and
  // the Playwright contract all use explicit .html addresses, and four assertions compare the final
  // URL exactly. `none` keeps the hosting faithful to the app instead of weakening the tests to
  // match a hosting default - and it is what lets the seven public redirects be an explicit list
  // rather than a blanket rule.
  //
  // The cost of `none` is that `/` resolves to nothing on its own, so the build emits a
  // `_redirects` file holding both tables: seven 200 rewrites (`/ /landing.html 200` - status 200
  // means an INTERNAL rewrite, so the browser's URL stays `/`) and seven 301s off the legacy .html
  // addresses. Cloudflare consumes `_redirects` as configuration and never serves it as an asset;
  // a test asserts it stays unreachable.
  "assets": {
    "directory": "./dist-cloudflare",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "binding": "ASSETS"
  },

  "vars": {
    "SUPABASE_URL": "https://tjzbehwfagiwpwodsgwg.supabase.co"
  },

  // Clips + timing metadata. Immutable objects named by content hash (js/read-aloud/tts-key.js).
  "r2_buckets": [
    { "binding": "TTS_BUCKET", "bucket_name": "laerlig-readaloud" }
  ],

  // One instance per clip key: concurrent misses for the same text are synthesised once.
  "durable_objects": {
    "bindings": [
      { "name": "TTS_CLIP", "class_name": "TtsClipCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1-tts-clip", "new_sqlite_classes": ["TtsClipCoordinator"] }
  ],

  // Cache misses only (a cached clip is never rate limited). Per signed-in user, plus a global
  // ceiling that also keeps a burst inside Azure's own request quota.
  "ratelimits": [
    { "name": "TTS_USER_RATE_LIMIT", "namespace_id": "15701", "simple": { "limit": 20, "period": 60 } },
    { "name": "TTS_GLOBAL_RATE_LIMIT", "namespace_id": "15702", "simple": { "limit": 60, "period": 60 } }
  ]
}
