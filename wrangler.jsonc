{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "den-seje-app-frontend",
  "compatibility_date": "2026-08-04",

  // ASSET-ONLY WORKER. There is deliberately no "main", no Worker script, no bindings and no
  // Functions: this deployment serves static files and nothing else. The app talks to Supabase
  // directly from the browser, exactly as it did on Vercel, so no server-side code is involved.
  //
  // "directory" is the generated output of tools/cloudflare-build-static.mjs — NEVER the repo
  // root. The root holds .env files, the docs/ decision register, tests/, tools/, supabase/ and
  // tracked node_modules; the build script copies only an explicit allowlist and then re-validates
  // the result, so none of that can be published.
  // ROUTING CONTRACT: ASYMMETRIC BY DESIGN.
  //
  //   public clean route      -> internal 200 rewrite to its HTML file (_redirects). The address
  //                              bar keeps the clean path; no 3xx is emitted.
  //   public legacy .html URL -> permanent 301 to the clean route. /produktet.html is no longer a
  //                              page of its own; one preferred URL per public page.
  //   internal app .html URL  -> UNCHANGED, a direct 200. /index.html, /login.html, /hub.html and
  //                              the rest keep their addresses.
  //   anything else           -> a real 404.
  //
  // `auto-trailing-slash` - the Cloudflare default - would strip the extension and 307 EVERY .html
  // address, the app included:
  //     /login.html -> 307 -> /login        /teacher.html -> 307 -> /teacher
  // This is a traditional multipage app: its runtime links, the role redirects in js/login.js and
  // the Playwright contract all use explicit .html addresses, and four assertions compare the final
  // URL exactly. `none` keeps the hosting faithful to the app instead of weakening the tests to
  // match a hosting default - and it is what lets the seven public redirects be an explicit list
  // rather than a blanket rule.
  //
  // The cost of `none` is that `/` resolves to nothing on its own, so the build emits a
  // `_redirects` file holding both tables: seven 200 rewrites (`/ /landing.html 200` - status 200
  // means an INTERNAL rewrite, so the browser's URL stays `/`) and seven 301s off the legacy .html
  // addresses. Cloudflare consumes `_redirects` as configuration and never serves it as an asset;
  // a test asserts it stays unreachable.
  "assets": {
    "directory": "./dist-cloudflare",
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
