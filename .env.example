# Test/CI environment — copy to .env (gitignored) and fill in real values.
# NEVER commit real secrets. .env is gitignored; this .env.example is the template.

# Supabase (used by global-setup health check + RLS/data specs)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Primary test student — Playwright E2E login (required)
TEST_STUDENT_EMAIL=student@example.com
TEST_STUDENT_PASSWORD=<password>

# Optional — teacher-flow specs. Defaults exist in tests/global-setup.ts if unset.
# TEST_TEACHER_EMAIL=teacher@example.com
# TEST_TEACHER_PASSWORD=<password>
# TEST_STUDENT2_EMAIL=student2@example.com
