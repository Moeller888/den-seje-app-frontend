# Test/CI environment — copy to .env (gitignored) and fill in real values.
# NEVER commit real secrets. .env is gitignored; this .env.example is the template.
# In CI every value below comes from a GitHub Actions secret of the same name.

# Supabase (used by global-setup health check + RLS/data specs)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Primary test student — Playwright E2E login (required)
TEST_STUDENT_EMAIL=student@example.com
TEST_STUDENT_PASSWORD=<password>

# Teacher-flow accounts. The PASSWORDS are required and have no default: global-setup stops when one
# is missing (tests/test-credentials.mjs). Set each to the password the account already has; changing
# an account's password is a separate, deliberate step, not a side effect of running the suite.
TEST_TEACHER_PASSWORD=<password>
TEST_STUDENT2_PASSWORD=<password>

# Optional — the teacher-flow e-mail addresses default to the public test identifiers.
# TEST_TEACHER_EMAIL=teacher@example.com
# TEST_STUDENT2_EMAIL=student2@example.com
