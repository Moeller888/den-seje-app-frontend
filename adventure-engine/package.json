{
  "name": "adventure-engine-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "lint": "eslint . && node tools/check-clean-room.mjs",
    "scenarios": "node --experimental-strip-types --no-warnings packages/scenario-runner/src/cli.ts",
    "content": "node --experimental-strip-types --no-warnings packages/content-tools/src/main.ts",
    "golden:update": "node --experimental-strip-types --no-warnings packages/scenario-runner/src/cli.ts --update-golden",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "dev": "vite packages/app",
    "build": "vite build packages/app",
    "e2e": "playwright test",
    "e2e:update-screenshots": "playwright test --project=chromium --update-snapshots",
    "preview": "vite preview packages/app"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "22.10.1",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.16.0",
    "fast-check": "3.23.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.17.0",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
