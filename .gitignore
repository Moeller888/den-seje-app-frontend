.vercel
.env*.local
.env*
!.env.example

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
.env
KUN TIL MIG.txt

# Debug/temp files
debug.html

# Avatar build/QA artifacts (164L) — regenerable, NOT runtime assets; never commit
tools/avatar/build/

# Vendored WebP encoder (libwebp cwebp.exe, gate 4) — binary, re-fetch via tools/avatar/fetch-cwebp; never commit
tools/avatar/vendor/

# Local-only artifacts — never commit (workspace hygiene)
# backups/: local prod snapshot(s); tools/164b-prototype/: obsolete prototype/scratch
backups/
tools/164b-prototype/

# Nested second clone of THIS repo (two-clone sync model: root + den-seje-app-frontend).
# It is a local working copy, NOT a submodule — it must never be tracked as a gitlink.
# Being tracked as a mode-160000 gitlink with no .gitmodules made `actions/checkout`
# post-cleanup run `git submodule foreach` and fail with "No url found for submodule …"
# (exit 128, emitted as a warning) on every CI run, and kept `M den-seje-app-frontend`
# permanently dirty. Untracked here so git ignores the embedded clone entirely.
den-seje-app-frontend/

# Cloudflare Workers Static Assets output — generated by tools/cloudflare-build-static.mjs from an
# explicit allowlist. Regenerable, and rebuilt on every deploy; never commit it.
dist-cloudflare/
