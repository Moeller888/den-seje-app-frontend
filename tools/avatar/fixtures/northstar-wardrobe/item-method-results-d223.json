  "visualReview": {
    "by": "Claude (not the owner)",
    "note": "seams ×2 reviewed for the tee + khaki, sweater + khaki and sweater + skirt outfits; white ticks at the khaki hem / sneaker collar and one light corner pixel at the right hip under tee and sweater registered as open (F-010 … F-012). The owner's visual approval is separate and has not been given"
  },
  "reviewImages": "<Documents>/DenSejeApp-artefacts/d-223-outfit-check/final-1/ (items/<id>/…; package/outfit-*.full.png, .app.png, .seams-x2.png; rejected-outfit-*; o01/o02 passed and rejected overviews; rejected-shoes-sandals-brown.png)",
  "nextStepRecommendation": {
    "verdict": "a larger VARIED pilot batch is the right next step — as an investigation of seams and fabric colours on C, not as production; it needs its own owner decision and call authorisation (nothing prepared here)",
    "why": "the method is reproducible and the remaining failures are systematic: items generated one by one do not always meet at the seams (khaki hem over boot, skirt waistband under sweater). Nine items cannot show how often that happens or which cuts and colours break extraction",
    "investigate": [
      "skin-like fabric colours (beige, peach, light orange, light pink, tan) — STRONG_TOL's known limit and the luminance shadow rule against an orange garment edge",
      "dark fabrics close to C's contour (black / charcoal trousers) — paint explained away by C's contour",
      "cuts at every seam: collared shirt and hoodie (neck/collar), cuffed long sleeves over the wrist (sleeve/wrist), crop and hip-length tops, tucked-in look (waist/hip), wide-leg, cuffed and capri trousers, a long skirt (hem/leg), ankle boots and high-tops of different shaft heights, low shoes (leg/shoe)",
      "seam agreement across categories: the share of outfits that pass the outfit check, by seam"
    ],
    "proposedCalls": {
      "authorised": 24,
      "reserve": 3,
      "max": 27,
      "split": "8 tops, 8 bottoms, 8 shoes — about a third in skin-like or very dark colours; one-shot claims, no retry, no fallback, the D-207 reserve rules"
    },
    "measure": [
      "items technically OK by category and cause",
      "outfits OK by seam (8 × 8 × 8 = 512 outfits of the passed items)",
      "findings per item and their kind",
      "manual minutes per item",
      "runtime per item and per outfit"
    ],
    "decideAfter": "whether to adapt the prompt per seam (shared hem heights, waistband heights), add a cross-item seam rule, or generate matched sets — before any production batch"
  }
