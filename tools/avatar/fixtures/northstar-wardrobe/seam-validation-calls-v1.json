  "acceptance": {
    "frozen": "before any call; never adjusted during or after the experiment to make a result pass",
    "axes": {
      "technical": "pipeline method d225 (D-223's extraction, fitCheck d222, covering D-218, skin shadow D-222) — the item is technically OK or rejected; unchanged rules",
      "contract": "BC.contractCheck(seam-contract-v1) per item: every SC rule recorded; the item's targetRules are the ones it was designed to meet",
      "combinationFit": "BC.outfitCheck revision d225 per outfit of the reuse matrix whose three items are technically OK; the findings register applies (an open finding keeps an outfit from being ready)",
      "visualQuality": "the owner's own review — never inferred from any check here"
    },
    "separation": "the contract is sufficient, not necessary: a contract break is NOT by itself a visible outfit fault, and a contract pass is not a visual approval. The three axes are reported apart and never merged into one verdict per item.",
    "questions": {
      "Q1": "seams: does each item meet its targetRules? (count of 6)",
      "Q2": "hip corners: SC-W2 for V1 and V2 (D-225 pilot baseline: 0 of 3 tops)",
      "Q3": "reuse: of the reuse matrix's available outfits, the share that passes the outfit check; per new item, the share of its own outfits (D-225 pilot baseline: 13 of 18 outfits pass the outfit check)"
    },
    "verdict": {
      "improves": "Q2 2 of 2 AND Q1 at least 4 of 6 AND Q3 at least 90 % of available outfits",
      "doesNotImprove": "Q2 0 of 2 AND Q1 at most 2 of 6",
      "otherwise": "partial — the failing seams and their classes named; no conclusion beyond them"
    },
    "failureClasses": {
      "generation": "the model did not follow the instruction or redrew the body (registration, base left, wrong length or width as drawn)",
      "extraction": "the tool missed paint or kept base (the picture has the material, the layer does not)",
      "composition": "layer order, covering, shadow or alignment in the combination",
      "contract": "the rule is incomplete or wrong: a visible fault no rule catches, or a rule break with no visible consequence anywhere"
    },
    "limits": [
      "six items, one picture each: no estimate of how often a model hits a seam",
      "no control without reference sheets: a pass shows the contract can be met with them, not that the sheet caused it",
      "a technical or contract pass is never the owner's visual approval"
    ],
    "noExpansion": "no further calls follow automatically, whatever the result"
